# Copia este archivo a .env antes de levantar nada.

# --- Postgres (lo consume docker-compose y la aplicacion) ---
# 5433 y no 5432: el 5432 suele estar tomado por un Postgres instalado en el host.
POSTGRES_USUARIO=ganaderia
POSTGRES_CLAVE=ganaderia
POSTGRES_BASE=ganaderia
POSTGRES_PUERTO=5433

# --- Aplicacion ---
# La app corre en el host, Postgres en Docker: por eso localhost.
GAN_URL_BASE_DATOS=postgresql+psycopg://ganaderia:ganaderia@localhost:5433/ganaderia
GAN_URL_BASE_DATOS_PRUEBAS=postgresql+psycopg://ganaderia:ganaderia@localhost:5433/ganaderia_pruebas

# Cambia esta clave en cualquier entorno que no sea tu maquina.
GAN_CLAVE_SECRETA=clave-de-desarrollo-no-usar-en-produccion
GAN_MINUTOS_TOKEN_ACCESO=30
GAN_DIAS_TOKEN_REFRESCO=14

# Origenes permitidos para el frontend de Vite.
GAN_ORIGENES_PERMITIDOS=http://localhost:5173
